*.py[cod]
*$py.class
.pytest_cache/
.coverage
.coverage.*
htmlcov/

# Local Python environments
.venv/
venv/
ENV/

# Local environment files; keep safe templates in version control
.env
.env.*
!.env.example
!.env.sample
!.env.template
!.env.*.example
!.env.*.sample
!.env.*.template

# Java and Gradle generated output
.gradle/
.kotlin/
*.class
/unidad1/*/build/
/unidad1/*/out/

